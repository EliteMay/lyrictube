{
  "appVersion": "v35",
  "dataFormatVersion": 3,
  "storageKey": "lyrictube.library.v3",
  "legacyStorageKey": "lyrictube.songs.v1",
  "external": {
    "lrclibSearch": "https://lrclib.net/api/search",
    "youtubeIframe": "https://www.youtube.com/iframe_api"
  },
  "notes": [
    "GitHub Pagesで動作する静的構成。Node.js/ローカルサーバー不要。",
    "ライブラリ保存形式はlyrictube.library.v3を維持。",
    "曲・歌詞・プレイリスト・設定はブラウザlocalStorageへ保存。",
    "v31ではdata/library.jsonを初回共有データとして読み込める。",
    "v31の簡易パスワードはdata/site-config.jsonへ平文保存する私的利用向け仕様。"
  ],
  "design": {
    "direction": "dark-music",
    "ambientThumbnail": true,
    "dynamicAccent": true,
    "fixedBottomPlayer": true
  },
  "smartViews": [
    "needsLyrics",
    "needsSync",
    "covers"
  ],
  "manualLyricsScrollPauseSeconds": 8,
  "playlistQuickAdd": {
    "enabled": true,
    "changesPlayback": false,
    "buttonLocation": "library-row-right"
  },
  "largeBrowsePage": {
    "enabled": true,
    "cardGrid": true,
    "keepBrowseOpenWhenPlaying": true,
    "quickPlaylistAddChangesPlayback": false
  },
  "lyricsTopLineFix": {
    "resetScrollOnRender": true,
    "topMaskRemoved": true,
    "internalScrollOnly": true
  },
  "playlistDialogFix": {
    "undefinedEscapeHtmlRemoved": true,
    "safeDomTextRendering": true,
    "quickAddKeepsPlayback": true
  },
  "lyricsFirstLineFix": {
    "resetAfterRenderFrames": true,
    "blockOldVideoTimeDuringSwitch": true,
    "resetWhenBeforeFirstTimestamp": true,
    "recoverFirstActiveLine": true,
    "topMaskFade": false
  },
  "lyricsNormalModeLayoutFix": {
    "headerSticky": false,
    "headerTopOffset": 0,
    "scrollChildMinHeightZero": true,
    "firstLineCoveredByHeader": false
  },
  "syncInterludeMarker": {
    "enabled": true,
    "markerText": "♪",
    "usesCurrentVideoTime": true,
    "versionSpecific": true,
    "undoable": true,
    "deletable": true,
    "preserveAfterLyricsEdit": true
  },
  "lyricsSearchV26": {
    "identifiedLrclibClient": true,
    "timeoutSeconds": 30,
    "retryServerErrors": 1,
    "honorRateLimit": true,
    "sequentialThrottleMs": 350,
    "resultCacheMinutes": 10,
    "savedLrclibIdFirst": true,
    "coverSingerArtistSeparation": true
  },
  "v27RegressionFix": {
    "restoredGoogleLyricsHelpers": true,
    "restoredYoutubePlayerMetadataFallback": true,
    "criticalDialogCloseFallback": true,
    "coreBootstrapBeforeOptionalEvents": true,
    "readyMarker": "data-lyric-tube-ready=v27"
  },
  "deployment": {
    "mode": "github-pages-static",
    "serverRequired": false,
    "githubPagesCompatible": true,
    "lrclibDirectBrowser": true,
    "youtubeDataApiSearch": false,
    "youtubeMetadataViaIframePlayer": true,
    "storage": "localStorage"
  },
  "v29BrandAndHelp": {
    "brandLogo": true,
    "favicon": true,
    "officialUiRefresh": true,
    "helpDialog": true,
    "helpTopics": [
      "overview",
      "player",
      "lyrics",
      "sync",
      "settings"
    ],
    "powerToysOcrGuide": true,
    "syncStampShortcut": "Shift+T"
  },
  "v29Settings": {
    "startupPage": true,
    "compactMode": true,
    "showArtwork": true,
    "glassEffect": true,
    "reduceMotion": true,
    "helpTips": true,
    "lyricsFontSize": true,
    "autoScroll": true,
    "bottomPlayer": true,
    "spotlight": true
  },
  "v30Fixes": {
    "sidebarScroll": true,
    "lyricsSizeButtons": true,
    "roundHelpIcons": true,
    "themeAccentConsistency": true,
    "lightThemeReadability": true
  },
  "duplicateVideoProtection": {
    "enabled": true,
    "scope": "all-songs-and-versions",
    "compareBy": "youtubeVideoId",
    "blockNewDuplicate": true,
    "blockEditToExistingVideo": true,
    "preserveExistingDuplicates": true
  },
  "v31MobileAccess": {
    "mobileBreakpoint": 900,
    "drawerSidebar": true,
    "singleColumnPlayer": true,
    "mobileDialogs": true,
    "safeArea": true,
    "simplePasswordConfig": "data/site-config.json",
    "sharedLibrarySeed": "data/library.json",
    "sharedSeedWhenLocalStorageEmpty": true,
    "sharedReloadButton": true,
    "serverRequired": false
  }
}
