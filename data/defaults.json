{
  "appVersion": "v0.13.2",
  "buildRevision": "20260902-1",
  "dataFormatVersion": 3,
  "dataSchemaVersion": 4,
  "storageKey": "lyrictube.library.v3",
  "legacyStorageKey": "lyrictube.songs.v1",
  "deployment": {
    "mode": "github-pages-static",
    "serverRequired": false,
    "githubPagesCompatible": true
  },
  "external": {
    "youtubeIframe": "https://www.youtube.com/iframe_api",
    "lyricsProviders": [
      "LRCLIB",
      "SyncLRC",
      "lyrics.ovh"
    ]
  },
  "storage": {
    "library": "localStorage + Supabase when signed in",
    "localMedia": "IndexedDB: lyrictube.localMedia.v1",
    "cloudQueue": "localStorage",
    "session": "sessionStorage"
  },
  "media": {
    "youtube": true,
    "localAudio": true,
    "localVideo": true,
    "localFilesUploadToCloud": false,
    "maxLocalFileBytes": 1073741824
  },
  "design": {
    "direction": "dark-music",
    "ambientThumbnail": true,
    "dynamicAccent": true,
    "fixedBottomPlayer": true,
    "mobileBreakpoint": 900
  },
  "features": {
    "multipleVersions": true,
    "playlists": true,
    "favorites": true,
    "recentlyPlayed": true,
    "tags": true,
    "songFormTagging": true,
    "lyricsSync": true,
    "manualLyricsEditing": true,
    "skipSegments": true,
    "startEndRange": true,
    "guestMode": true,
    "cloudAccounts": true,
    "selfServiceAccountRegistration": true,
    "rememberLastAccountName": true
  },
  "security": {
    "passwordStoredClientSide": false,
    "credentialsInRepository": false,
    "registrationKeyStoredClientSide": false,
    "loginRateLimit": {
      "windowMinutes": 10,
      "maxFailures": 5,
      "blockMinutes": 15
    },
    "registrationKeyRateLimit": {
      "windowMinutes": 10,
      "maxFailures": 5,
      "blockMinutes": 15
    }
  },
  "notes": [
    "現行仕様はREADME.mdとdocs配下を正とする。",
    "端末のMP3/MP4本体はGitHubやSupabaseへ保存しない。",
    "旧v29〜v36の開発番号・簡易パスワード設定は現行仕様ではない。"
  ]
}
